---
/* ==========================================================================
   Datos del sitio
   ========================================================================== */
const siteUrl = 'https://origen.plus/';
const title = 'ORIGEN plus | Productos naturales en Cali, Colombia';
const description =
  'ORIGEN plus, marca de producto natural de la línea ORIGEN en Cali, Colombia. Bebida a base de agua con fruta en 350 mL y 30 mL / 1 fl oz.';
const ogImage = `${siteUrl}images/og-origen-1200x630.jpg`;
const ogImageAlt =
  'ORIGEN plus, producto natural de la línea ORIGEN en Cali, Colombia';

/* ==========================================================================
   Datos estructurados (schema.org)
   ========================================================================== */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'ORIGEN plus',
      alternateName: ['ORIGEN', 'origen.plus'],
      inLanguage: 'es-CO',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'ORIGEN plus',
      alternateName: 'ORIGEN',
      url: siteUrl,
      logo: `${siteUrl}icons/origen-512.png`,
      description:
        'Marca de producto natural de la línea ORIGEN, con sede en Cali, Colombia.',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Cali',
        addressRegion: 'Valle del Cauca',
        addressCountry: 'CO',
      },
      email: 'hola@origen.plus',
      // Descomenta y completa cuando tengas redes con el mismo nombre:
      // sameAs: [
      //   'https://www.instagram.com/TU_USUARIO',
      //   'https://www.facebook.com/TU_PAGINA',
      // ],
    },
  ],
};

/* ==========================================================================
   Contenido de la página
   ========================================================================== */
const navLinks = [
  { href: '#producto', label: 'Producto' },
  { href: '#detalle', label: 'Detalles' },
  { href: '#marca', label: 'Marca' },
  { href: '#contacto', label: 'Contacto' },
];

const specs = [
  { value: '350 mL', label: 'Formato hogar' },
  { value: '30 mL', label: 'Formato individual' },
  { value: '1 fl oz', label: 'Presentación individual' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-CO">
  <head>
    <!-- Base -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="ORIGEN plus" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- PWA e iconos -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/origen-192.png" />
    <link rel="apple-touch-icon" href="/icons/origen-192.png" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- ================= NAVBAR ================= -->
    <header class="navbar">
      <button id="install-pwa" class="install-button" hidden>
        Instalar ORIGEN
      </button>

      <a href="/" class="logo">ORIGEN</a>

      <nav aria-label="Principal">
        {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
    </header>

    <main>
      <!-- ================= HERO ================= -->
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">Cali, Colombia</p>

          <h1>
            ORIGEN plus
            <span>producto natural de la línea ORIGEN.</span>
          </h1>

          <p class="hero-text">
            ORIGEN plus es una marca de producto natural de la línea ORIGEN,
            de Cali, Colombia: una bebida a base de agua con fruta, en 350 mL
            para tener en casa y 30 mL / 1 fl oz para llevar.
          </p>

          <a href="#producto" class="button">Conocer ORIGEN</a>
        </div>

        <div class="hero-product">
          <div class="glow"></div>

          <img
            src="/images/envase-origen-25ml.webp"
            alt="Envase de ORIGEN plus, bebida a base de agua con fruta"
            width="430"
            height="650"
            fetchpriority="high"
          />
        </div>
      </section>

      <!-- ================= PRODUCTO ================= -->
      <section id="producto" class="product-section">
        <div class="section-image">
          <img
            src="/images/envase-origen-25ml.webp"
            alt="Envase individual de ORIGEN plus de 30 mL"
            width="380"
            height="570"
            loading="lazy"
          />
        </div>

        <div class="section-content">
          <p class="eyebrow">ORIGEN plus</p>

          <h2>
            Una fórmula.
            <span>Dos formatos.</span>
          </h2>

          <p>
            ORIGEN plus es una bebida a base de agua con fruta. Su propuesta
            contempla una presentación de 350 mL para tener en casa y una
            presentación individual de 30 mL / 1 fl oz para llevar.
          </p>

          <div class="specs">
            {specs.map(({ value, label }) => (
              <div>
                <strong>{value}</strong>
                <span>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= DETALLE ================= -->
      <section id="detalle" class="detail-section">
        <div>
          <p class="eyebrow">LA PROPUESTA</p>

          <h2>
            ORIGEN
            <span>se adapta.</span>
          </h2>

          <p>
            El formato de 350 mL está pensado para tener ORIGEN disponible en
            casa. El formato individual de 30 mL / 1 fl oz está pensado para
            llevar fácilmente contigo.
          </p>

          <p>
            La presentación, el contenido y la información del producto se
            irán actualizando conforme avance la producción y tengamos la
            información técnica definitiva.
          </p>
        </div>

        <div class="cap-card">
          <img
            src="/images/tapa-blanca.webp"
            alt="Detalle de la tapa blanca del envase de ORIGEN plus"
            width="400"
            height="400"
            loading="lazy"
          />
        </div>
      </section>

      <!-- ================= MARCA ================= -->
      <section id="marca" class="brand-section">
        <p class="eyebrow">LA MARCA</p>

        <h2>
          Línea ORIGEN
          <span>desde Cali, Colombia.</span>
        </h2>

        <p>
          ORIGEN es una línea de productos naturales creada en Cali, Valle del
          Cauca. ORIGEN plus es su bebida a base de agua con fruta, pensada
          para acompañarte en casa y fuera de ella.
        </p>
      </section>

      <!-- ================= CONTACTO ================= -->
      <section id="contacto" class="cta">
        <p class="eyebrow">ORIGEN plus</p>

        <h2>
          Una fórmula.
          <span>Dos formas de llevarla.</span>
        </h2>

        <a href="mailto:hola@origen.plus" class="button">Contactar</a>
      </section>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer>
      <span>© {year} ORIGEN · Cali, Colombia</span>
      <span>origen.plus</span>
    </footer>

    <!-- ================= PWA ================= -->
    <script>
      // Service worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }

      // Botón "Instalar ORIGEN"
      let deferredPrompt: any = null;
      const installButton =
        document.querySelector<HTMLButtonElement>('#install-pwa');

      const hideInstallButton = () => {
        if (installButton) installButton.hidden = true;
      };

      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        deferredPrompt = event;
        if (installButton) installButton.hidden = false;
      });

      installButton?.addEventListener('click', async () => {
        if (!deferredPrompt) return;

        deferredPrompt.prompt();
        await deferredPrompt.userChoice;

        deferredPrompt = null;
        hideInstallButton();
      });

      window.addEventListener('appinstalled', hideInstallButton);
    </script>
  </body>
</html>

<style>
  /* ==========================================================================
     Base
     ========================================================================== */
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0a0a0a;
    color: #f5f3ed;
    font-family: 'DM Sans', sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(48px, 7vw, 100px);
  }

  h2 {
    font-size: clamp(48px, 6vw, 86px);
  }

  h1 span,
  h2 span {
    display: block;
    color: #b8a47c;
  }

  h1 span {
    margin-top: 12px;
    font-size: 0.45em;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .eyebrow {
    margin-bottom: 22px;
    color: #aaa;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.25em;
  }

  /* ==========================================================================
     Botones
     ========================================================================== */
  .button {
    display: inline-flex;
    padding: 15px 24px;
    border: 1px solid #777;
    border-radius: 999px;
    font-size: 14px;
    transition: all 0.25s ease;
  }

  .button:hover {
    background: #f5f3ed;
    color: #0a0a0a;
    border-color: #f5f3ed;
  }

  .install-button {
    padding: 10px 16px;
    border: 1px solid #b8a47c;
    border-radius: 999px;
    background: transparent;
    color: #f5f3ed;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .install-button:hover {
    background: #b8a47c;
    color: #0a0a0a;
  }

  /* ==========================================================================
     Navbar
     ========================================================================== */
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    width: 100%;
    padding: 28px 6vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  nav {
    display: flex;
    gap: 32px;
    color: #aaa;
    font-size: 14px;
  }

  nav a {
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: white;
  }

  /* ==========================================================================
     Hero
     ========================================================================== */
  .hero {
    min-height: 100vh;
    padding: 120px 8vw 70px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 620px;
  }

  .hero-text {
    max-width: 450px;
    margin: 32px 0;
    color: #aaa;
    font-size: 17px;
    line-height: 1.7;
  }

  .hero-product {
    position: relative;
    min-height: 650px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-product img {
    position: relative;
    z-index: 2;
    width: min(75%, 430px);
    height: auto;
    max-height: 650px;
    object-fit: contain;
    filter: drop-shadow(0 35px 60px rgba(0, 0, 0, 0.8));
  }

  .glow {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: #b8a47c;
    opacity: 0.08;
    filter: blur(100px);
  }

  /* ==========================================================================
     Producto y Detalle
     ========================================================================== */
  .product-section,
  .detail-section {
    padding: 140px 10vw;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10vw;
    align-items: center;
  }

  .section-content p,
  .detail-section p {
    max-width: 520px;
    margin-top: 30px;
    color: #999;
    font-size: 17px;
    line-height: 1.8;
  }

  .section-image {
    display: flex;
    justify-content: center;
  }

  .section-image img {
    width: min(70%, 380px);
    height: auto;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.7));
  }

  .specs {
    margin-top: 50px;
    display: flex;
    gap: 45px;
  }

  .specs div {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .specs strong {
    font-size: 22px;
  }

  .specs span {
    color: #777;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .cap-card {
    min-height: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    border: 1px solid #222;
  }

  .cap-card img {
    width: 70%;
    height: auto;
  }

  /* ==========================================================================
     Marca
     ========================================================================== */
  .brand-section {
    padding: 120px 10vw;
    border-top: 1px solid #1e1e1e;
  }

  .brand-section p:not(.eyebrow) {
    max-width: 620px;
    margin-top: 30px;
    color: #999;
    font-size: 17px;
    line-height: 1.8;
  }

  /* ==========================================================================
     Contacto (CTA)
     ========================================================================== */
  .cta {
    min-height: 70vh;
    padding: 120px 8vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #10100f;
  }

  .cta h2 {
    margin-bottom: 45px;
  }

  /* ==========================================================================
     Footer
     ========================================================================== */
  footer {
    padding: 28px 6vw;
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 12px;
    border-top: 1px solid #1e1e1e;
  }

  /* ==========================================================================
     Responsive (móvil)
     ========================================================================== */
  @media (max-width: 800px) {
    nav {
      display: none;
    }

    .install-button {
      padding: 8px 12px;
      font-size: 11px;
    }

    .hero {
      grid-template-columns: 1fr;
      padding-top: 140px;
    }

    .hero-product {
      min-height: 480px;
    }

    .hero-product img {
      width: 70%;
    }

    .product-section,
    .detail-section {
      grid-template-columns: 1fr;
      padding: 100px 8vw;
    }

    .detail-section {
      display: flex;
      flex-direction: column;
    }

    .brand-section {
      padding: 100px 8vw;
    }

    .specs {
      gap: 25px;
      flex-wrap: wrap;
    }

    footer {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
